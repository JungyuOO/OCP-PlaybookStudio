# Generated artifacts
ARTIFACTS_DIR=artifacts
SOURCE_MANIFEST_PATH=manifests/ocp_ko_4_20_approved_ko.json

# OCP Ops live integration
OCP_API_BASE_URL=
OCP_API_TOKEN=
OCP_DEFAULT_NAMESPACE=demo
OCP_VERIFY_SSL=false

# Chat/runtime endpoints
EMBEDDING_BASE_URL=http://tei.example.com/v1
EMBEDDING_MODEL=dragonkue/bge-m3-ko
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=8

QDRANT_URL=http://127.0.0.1:6335
QDRANT_COLLECTION=openshift_docs
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=Cosine
QDRANT_UPSERT_BATCH_SIZE=128
QDRANT_RECREATE_COLLECTION=false

GRAPH_ENABLED=false
GRAPH_BACKEND=local
GRAPH_URI=
GRAPH_USERNAME=
GRAPH_PASSWORD=
GRAPH_DATABASE=
GRAPH_BOOST_TOP_N=8
GRAPH_MAX_EDGE_FANOUT=12

# Required local DB/runtime state
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=rag_task
DB_USER=rag_user
DB_PASSWORD=rag_password

LLM_ENDPOINT=http://llm.example.com/v1
LLM_MODEL=Qwen/Qwen3.5-9B
SURYA_OCR=
SURYA_HEALTH=
RERANKER_ENABLED=true
RERANKER_TOP_N=12
RERANKER_BATCH_SIZE=8
RERANKER_DEVICE=auto

# Optional GitHub PAT for repo validation
GITHUB_CLASSIC_TOKEN=

# SCM OAuth
SCM_GITHUB_CLIENT_ID=
SCM_GITHUB_CLIENT_SECRET=
SCM_GITHUB_SCOPE=read:user repo
SCM_GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
SCM_GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
SCM_GITHUB_USER_URL=https://api.github.com/user

SCM_GITLAB_CLIENT_ID=
SCM_GITLAB_CLIENT_SECRET=
SCM_GITLAB_SCOPE=read_user api
SCM_GITLAB_AUTHORIZE_URL=https://gitlab.com/oauth/authorize
SCM_GITLAB_TOKEN_URL=https://gitlab.com/oauth/token
SCM_GITLAB_USER_URL=https://gitlab.com/api/v4/user
